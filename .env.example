# Averdi Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# AUTHENTICATION
# ===========================================

# JWT Secret for session tokens (minimum 32 characters)
# Generate a secure key: openssl rand -base64 32
JWT_SECRET=your-32-character-minimum-secret-key

# Initial admin user credentials (used only for first setup)
# The initial admin user is created in src/data/users.json
# Default email: admin@averdi.no
# Default password: admin123 (change this immediately!)
ADMIN_INITIAL_EMAIL=admin@averdi.no
ADMIN_INITIAL_PASSWORD=secure-password-change-me

# ===========================================
# ANALYTICS
# ===========================================

# Hotjar Site ID
# Get your Site ID from: https://insights.hotjar.com/site/list
# Example: NEXT_PUBLIC_HOTJAR_ID=1234567
NEXT_PUBLIC_HOTJAR_ID=

# ===========================================
# SITE CONFIGURATION
# ===========================================

# Public site URL (used for sitemap generation, OG images, etc.)
NEXT_PUBLIC_SITE_URL=https://averdi.no

# Internal site URL (for server-side operations)
SITE_URL=https://www.averdi.no
